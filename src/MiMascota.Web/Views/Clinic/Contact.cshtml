@using Microsoft.Extensions.Options
@using MiMascota.Web.Options
@model ContactFormViewModel
@inject IOptions<ClinicOptions> ClinicOptions
@inject IClinicHours ClinicHours
@{
    ViewData["Title"] = "Contacto";
    var clinic = ClinicOptions.Value;
    var service = ViewData["Service"] as string;
}
<header class="page-head">
    <div class="page-head-text">
        <span class="eyebrow">Ayuda</span>
        <h1 class="page-title">Contacto</h1>
        <p class="page-sub">¿Quieres agendar una cita, cambiarla o tienes una duda? Escríbenos y te respondemos para confirmar el horario.</p>
        @if (User.IsStaff())
        {
            <div class="page-actions">
                <a class="mm-btn mm-btn-ghost" asp-action="Messages"><i class="bi bi-inbox-fill" aria-hidden="true"></i> Mensajes recibidos</a>
            </div>
        }
        else if (service is not null)
        {
            <div class="page-actions">
                <span class="chip-soft"><i class="bi bi-calendar2-heart" aria-hidden="true"></i> Servicio: @service</span>
            </div>
        }
    </div>
    <span class="page-giant" aria-hidden="true">hola</span>
    <img class="page-pet page-pet-salchicha" src="~/img/mascotas/salchicha-enfermera.webp" alt="" width="921" height="583" />
</header>

<div class="clinic-split">
    <form asp-action="Contact" method="post" class="mm-card mm-form contact-form" novalidate>
        <h2 class="clinic-title">Envíanos un mensaje</h2>
        <div asp-validation-summary="ModelOnly" class="mm-alert mm-alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="name" placeholder="Ej. María López" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Contact" class="form-label"></label>
            <input asp-for="Contact" class="form-control" autocomplete="email" placeholder="789 123 4567 o tu@correo.com" />
            <span asp-validation-for="Contact" class="field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Message" class="form-label"></label>
            <textarea asp-for="Message" class="form-control" rows="5" placeholder="Cuéntanos en qué te ayudamos"></textarea>
            <span asp-validation-for="Message" class="field-error"></span>
        </div>

        <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg">
            <i class="bi bi-send-fill" aria-hidden="true"></i> Enviar mensaje
        </button>
        <p class="clinic-note mt-3 mb-0">Usamos estos datos solo para responderte. Lee el <a asp-action="Privacy">Aviso de privacidad</a>.</p>
    </form>

    <aside class="mm-card clinic-card clinic-card-accent" aria-labelledby="visit-title">
        <h2 id="visit-title" class="clinic-title">También puedes visitarnos</h2>
        <ul class="fact-list">
            <li><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> <a asp-action="Directions">Centro, Tantoyuca, Veracruz</a></li>
            <li><i class="bi bi-clock-fill" aria-hidden="true"></i> <a asp-action="Hours">@clinic.OpenDaysLabel() · @clinic.HoursLabel()</a></li>
            <li><i class="bi bi-tags-fill" aria-hidden="true"></i> <a asp-controller="Services" asp-action="Index">Servicios y precios</a></li>
        </ul>
        <div class="mt-3">
            <partial name="_OpenBadge" model="ClinicHours.GetStatus()" />
        </div>
        <p class="clinic-note mt-3 mb-0">Para cancelar una cita, indica el nombre de tu mascota y el día de la cita.</p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
