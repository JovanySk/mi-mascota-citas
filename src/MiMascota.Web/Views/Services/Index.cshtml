@model IReadOnlyList<VetService>
@{
    ViewData["Title"] = "Servicios";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Servicios</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo servicio</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No hay servicios registrados.</div>
}
else
{
    <div class="card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Servicio</th>
                    <th>Duración</th>
                    <th>Precio</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in Model)
                {
                    <tr>
                        <td class="fw-semibold">@service.Name</td>
                        <td>@service.DurationMinutes min</td>
                        <td>@service.Price.ToString("C")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@service.Id">Editar</a>
                            <form asp-action="Delete" asp-route-id="@service.Id" method="post" class="d-inline"
                                  data-confirm="¿Eliminar el servicio @service.Name?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
