@using Microsoft.Extensions.Options
@using MiMascota.Web.Options
@inject IOptions<ClinicOptions> ClinicOptions
@model AppointmentFormViewModel
@{
    ViewData["Title"] = "Nueva cita";
    var clinic = ClinicOptions.Value;
}
<header class="page-head">
    <div class="page-head-text">
        <span class="eyebrow">Agenda</span>
        <h1 class="page-title">Nueva cita</h1>
        <p class="page-sub">Elige servicio y fecha: solo verás horarios libres, sin empalmes.</p>
    </div>
    <span class="page-giant" aria-hidden="true">cita</span>
    <img class="page-pet page-pet-perro" src="~/img/mascotas/perro-pata.webp" alt="" width="468" height="900" />
</header>

<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Create" method="post" class="mm-card mm-form" id="appointment-form">
            <div asp-validation-summary="ModelOnly" class="mm-alert mm-alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="PetId" class="form-label"></label>
                <select asp-for="PetId" asp-items="Model.Pets" class="form-select">
                    <option value="">Selecciona una mascota…</option>
                </select>
                <span asp-validation-for="PetId" class="field-error"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-7">
                    <label asp-for="ServiceId" class="form-label"></label>
                    <select asp-for="ServiceId" asp-items="Model.Services" class="form-select">
                        <option value="">Selecciona un servicio…</option>
                    </select>
                    <span asp-validation-for="ServiceId" class="field-error"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" type="date" class="form-control" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Date" class="field-error"></span>
                </div>
            </div>

            <div class="mb-3">
                <span class="form-label d-block" id="slots-label">Horarios disponibles</span>
                @* Filled by wwwroot/js/appointment-create.js with the JSON from /Appointments/Availability *@
                <div id="slots" class="slot-grid" role="radiogroup" aria-labelledby="slots-label"
                     data-availability-url="@Url.Action("Availability", "Appointments")"
                     data-selected="@Model.StartTime?.ToString("HH:mm")"></div>
                <div id="slots-message" class="form-text" aria-live="polite"></div>
                <span asp-validation-for="StartTime" class="field-error"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Síntomas, indicaciones, etc. (opcional)"></textarea>
                <span asp-validation-for="Notes" class="field-error"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg"><i class="bi bi-check2" aria-hidden="true"></i> Agendar cita</button>
                <a asp-action="Index" class="mm-btn mm-btn-ghost mm-btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
    <div class="col-lg-4">
        <aside class="mm-card help-card">
            <h2 class="help-title">¿Cómo funciona?</h2>
            <ol class="help-steps">
                <li>Elige servicio y fecha: los horarios libres se cargan al instante, sin recargar la página.</li>
                <li>Solo aparecen horarios que no se empalman con otras citas y que terminan antes del cierre.</li>
                <li>Horario de atención: @clinic.OpenDaysLabel(), @clinic.HoursLabel(), con citas cada @clinic.SlotMinutes minutos.</li>
                <li>La cita se crea como <partial name="_StatusBadge" model="AppointmentStatus.Pending" /> y se confirma desde la lista de citas.</li>
            </ol>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment-create.js" asp-append-version="true"></script>
}
