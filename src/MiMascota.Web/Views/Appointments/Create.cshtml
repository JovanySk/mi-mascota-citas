@using Microsoft.Extensions.Options
@using MiMascota.Web.Options
@inject IOptions<ClinicOptions> ClinicOptions
@model AppointmentFormViewModel
@{
    ViewData["Title"] = "Nueva cita";
    var clinic = ClinicOptions.Value;
    var selectedPet = Model.Pets.FirstOrDefault(p => p.Id == Model.PetId);
    var hasOwners = Model.Owners.Any();
}
<header class="page-head">
    <div class="page-head-text">
        <span class="eyebrow">Agenda</span>
        <h1 class="page-title">Nueva cita</h1>
        <p class="page-sub">Elige servicio y fecha: solo verás horarios libres, sin empalmes.</p>
    </div>
    <span class="page-giant" aria-hidden="true">cita</span>
    <img class="page-pet page-pet-perro" src="~/img/mascotas/perro-pata.webp" alt="" width="468" height="900" />
</header>

<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Create" method="post" class="mm-card mm-form" id="appointment-form">
            <div asp-validation-summary="ModelOnly" class="mm-alert mm-alert-danger" role="alert"></div>

            <div id="quick-pet-success" class="mm-alert mm-alert-success" role="status" hidden></div>

            <div class="mb-3">
                <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-1">
                    <label asp-for="PetId" class="form-label mb-0"></label>
                    <button type="button" class="link-add" data-bs-toggle="modal" data-bs-target="#quick-pet-modal">
                        <i class="bi bi-plus-circle-fill" aria-hidden="true"></i> Registrar mascota nueva
                    </button>
                </div>
                <div class="pet-select">
                    <span class="pet-avatar" data-pet-avatar>
                        <img src="@(selectedPet?.Avatar ?? "/img/paw.svg")" alt="" width="96" height="96" data-empty="/img/paw.svg" />
                    </span>
                    <select asp-for="PetId" class="form-select">
                        <option value="">Selecciona una mascota…</option>
                        @foreach (var pet in Model.Pets)
                        {
                            <option value="@pet.Id" data-avatar="@pet.Avatar">@pet.Label</option>
                        }
                    </select>
                </div>
                <span asp-validation-for="PetId" class="field-error"></span>
                <div class="form-text">¿Paciente nuevo? Regístralo aquí mismo sin salir de la cita: perro, gato, cotorro, tortuga…</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-7">
                    <label asp-for="ServiceId" class="form-label"></label>
                    <select asp-for="ServiceId" asp-items="Model.Services" class="form-select">
                        <option value="">Selecciona un servicio…</option>
                    </select>
                    <span asp-validation-for="ServiceId" class="field-error"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" type="date" class="form-control" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Date" class="field-error"></span>
                </div>
            </div>

            <div class="mb-3">
                <span class="form-label d-block" id="slots-label">Horarios disponibles</span>
                @* Filled by wwwroot/js/appointment-create.js with the JSON from /Appointments/Availability *@
                <div id="slots" class="slot-grid" role="radiogroup" aria-labelledby="slots-label"
                     data-availability-url="@Url.Action("Availability", "Appointments")"
                     data-selected="@Model.StartTime?.ToString("HH:mm")"></div>
                <div id="slots-message" class="form-text" aria-live="polite"></div>
                <span asp-validation-for="StartTime" class="field-error"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Síntomas, indicaciones, etc. (opcional)"></textarea>
                <span asp-validation-for="Notes" class="field-error"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg"><i class="bi bi-check2" aria-hidden="true"></i> Agendar cita</button>
                <a asp-action="Index" class="mm-btn mm-btn-ghost mm-btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
    <div class="col-lg-4">
        <aside class="mm-card help-card">
            <h2 class="help-title">¿Cómo funciona?</h2>
            <ol class="help-steps">
                <li>Elige servicio y fecha: los horarios libres se cargan al instante, sin recargar la página.</li>
                <li>Solo aparecen horarios que no se empalman con otras citas y que terminan antes del cierre.</li>
                <li>Horario de atención: @clinic.OpenDaysLabel(), @clinic.HoursLabel(), con citas cada @clinic.SlotMinutes minutos.</li>
                <li>La cita se crea como <partial name="_StatusBadge" model="AppointmentStatus.Pending" /> y se confirma desde la lista de citas.</li>
            </ol>
        </aside>
    </div>
</div>

@* Quick registration of a pet (and, if needed, its owner) without leaving the booking form.
   Posted with AJAX to /Pets/QuickCreate by wwwroot/js/quick-pet.js. *@
<div class="modal fade mm-modal" id="quick-pet-modal" tabindex="-1" aria-labelledby="quick-pet-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
        <form class="modal-content" id="quick-pet-form" asp-controller="Pets" asp-action="QuickCreate" method="post"
              enctype="multipart/form-data" novalidate>
            <div class="modal-header">
                <div>
                    <span class="eyebrow">Paciente nuevo</span>
                    <h2 class="modal-title" id="quick-pet-title">Registrar mascota</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mm-alert mm-alert-danger" data-error-summary role="alert" hidden></div>

                <div class="mb-4">
                    <partial name="_PhotoField" model='new PhotoFieldModel(null, "/img/paw.svg", "qp-photo")' />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="qp-name">Nombre</label>
                        <input class="form-control" id="qp-name" name="Name" maxlength="60" autocomplete="off" />
                        <span class="field-error" data-error-for="Name"></span>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="qp-breed">Raza <span class="label-optional">(opcional)</span></label>
                        <input class="form-control" id="qp-breed" name="Breed" maxlength="60" placeholder="ej. Perico australiano" autocomplete="off" />
                        <span class="field-error" data-error-for="Breed"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <span class="form-label d-block" id="qp-species-label">Especie</span>
                    <partial name="_SpeciesPicker" model='new SpeciesPickerModel(null, "qp-species")' />
                    <span class="field-error" data-error-for="Species"></span>
                    <span class="field-error" data-error-for="SpeciesOther"></span>
                </div>

                <fieldset class="mb-2">
                    <legend class="form-label">Dueño</legend>
                    <div class="mm-segmented mb-3" role="radiogroup" aria-label="Tipo de dueño">
                        <input type="radio" class="btn-check" name="NewOwner" id="qp-owner-existing" value="false" checked="@hasOwners" />
                        <label for="qp-owner-existing">Ya es cliente</label>
                        <input type="radio" class="btn-check" name="NewOwner" id="qp-owner-new" value="true" checked="@(!hasOwners)" />
                        <label for="qp-owner-new">Dueño nuevo</label>
                    </div>
                    <div data-owner-existing>
                        <label class="visually-hidden" for="qp-owner">Dueño</label>
                        <select class="form-select" id="qp-owner" name="OwnerId" asp-items="Model.Owners">
                            <option value="0">Selecciona un dueño…</option>
                        </select>
                        <span class="field-error" data-error-for="OwnerId"></span>
                    </div>
                    <div class="row g-3" data-owner-new hidden>
                        <div class="col-sm-7">
                            <label class="form-label" for="qp-owner-name">Nombre del dueño</label>
                            <input class="form-control" id="qp-owner-name" name="OwnerName" maxlength="100" autocomplete="off" />
                            <span class="field-error" data-error-for="OwnerName"></span>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label" for="qp-owner-phone">Teléfono</label>
                            <input class="form-control" id="qp-owner-phone" name="OwnerPhone" type="tel" maxlength="20" placeholder="55 1234 5678" autocomplete="off" />
                            <span class="field-error" data-error-for="OwnerPhone"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="mm-btn mm-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="mm-btn mm-btn-primary" data-submit><i class="bi bi-check2" aria-hidden="true"></i> Registrar mascota</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment-create.js" asp-append-version="true"></script>
    <script src="~/js/pet-form.js" asp-append-version="true"></script>
    <script src="~/js/quick-pet.js" asp-append-version="true"></script>
}
