@model AppointmentListViewModel
@{
    ViewData["Title"] = "Citas";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Citas</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")">
        <i class="bi bi-calendar-plus"></i> Nueva cita
    </a>
</div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-4 col-md-3">
            <label for="date" class="form-label small">Fecha</label>
            <input type="date" id="date" name="date" class="form-control" value="@Model.Date?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-sm-4 col-md-3">
            <label for="status" class="form-label small">Estado</label>
            <select id="status" name="status" class="form-select">
                <option value="">Todos</option>
                @foreach (var status in Enum.GetValues<AppointmentStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@status.ToDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel"></i> Filtrar</button>
            <a asp-action="Index" class="btn btn-link">Ver todas</a>
        </div>
    </div>
</form>

@if (Model.Appointments.Count == 0)
{
    <div class="alert alert-light border">No hay citas con esos filtros.</div>
}
else
{
    <div class="card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Horario</th>
                    <th>Mascota</th>
                    <th>Servicio</th>
                    <th>Estado</th>
                    <th>Notas</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Appointments)
                {
                    var nextStates = AppointmentStateMachine.NextStates(a.Status);
                    <tr>
                        <td class="text-nowrap">@a.Start.ToString("ddd dd/MM/yyyy")</td>
                        <td class="text-nowrap">@a.Start.ToString("HH:mm")–@a.End.ToString("HH:mm")</td>
                        <td>
                            <div class="fw-semibold">@a.Pet?.Name</div>
                            <div class="small text-muted">@a.Pet?.Owner?.Name</div>
                        </td>
                        <td>@a.VetService?.Name</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                        <td class="small text-muted">@a.Notes</td>
                        <td class="text-end text-nowrap">
                            @foreach (var next in nextStates)
                            {
                                var css = next switch
                                {
                                    AppointmentStatus.Confirmed => "btn-outline-primary",
                                    AppointmentStatus.Attended => "btn-outline-success",
                                    _ => "btn-outline-danger"
                                };
                                <form asp-action="ChangeStatus" asp-route-id="@a.Id" method="post"
                                      class="d-inline"
                                      data-confirm="@(next == AppointmentStatus.Cancelled ? $"¿Cancelar la cita de {a.Pet?.Name}? Esta acción no se puede deshacer." : null)">
                                    <input type="hidden" name="status" value="@next" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm @css">@next.ToActionLabel()</button>
                                </form>
                            }
                            @if (nextStates.Count == 0)
                            {
                                <span class="small text-muted">Sin acciones</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-muted mt-2">
        @Model.Appointments.Count cita(s). Flujo de estados: Pendiente → Confirmada → Atendida; Pendiente o Confirmada → Cancelada.
    </p>
}

