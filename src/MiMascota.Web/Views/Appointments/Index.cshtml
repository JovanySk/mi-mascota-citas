@model AppointmentListViewModel
@{
    ViewData["Title"] = "Citas";
    ViewData["ShowDate"] = true;
}
<header class="page-head">
    <div class="page-head-text">
        <span class="eyebrow">Agenda</span>
        <h1 class="page-title">Citas</h1>
        <p class="page-sub">Filtra por día y estado. Cada cita muestra solo los cambios de estado permitidos.</p>
        <div class="page-actions">
            <a class="mm-btn mm-btn-primary" asp-action="Create" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")">+ Nueva cita</a>
        </div>
    </div>
    <span class="page-giant" aria-hidden="true">citas</span>
    <img class="page-pet page-pet-hamster" src="~/img/mascotas/hamster.webp" alt="" width="519" height="726" />
</header>

<form method="get" asp-action="Index" class="mm-card filter-bar">
    <div class="filter-field">
        <label for="date" class="form-label">Fecha</label>
        <input type="date" id="date" name="date" class="form-control" value="@Model.Date?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filter-field">
        <label for="status" class="form-label">Estado</label>
        <select id="status" name="status" class="form-select">
            <option value="">Todos</option>
            @foreach (var status in Enum.GetValues<AppointmentStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@status.ToDisplayName()</option>
            }
        </select>
    </div>
    <div class="filter-buttons">
        <button type="submit" class="mm-btn mm-btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar</button>
        <a asp-action="Index" class="mm-btn mm-btn-ghost">Ver todas</a>
    </div>
</form>

@if (Model.Appointments.Count == 0)
{
    <div class="empty-state">
        <img src="~/img/mascotas/avatar/cuyo.webp" alt="" width="96" height="96" />
        <div>
            <strong>No hay citas con esos filtros.</strong>
            <p class="mb-0">Prueba con otra fecha o <a asp-action="Index">ve todas las citas</a>.</p>
        </div>
    </div>
}
else
{
    <ul class="appt-list">
        @foreach (var a in Model.Appointments)
        {
            <li><partial name="_AppointmentRow" model="a" /></li>
        }
    </ul>
    <p class="list-foot">
        @Model.Appointments.Count cita(s). Flujo de estados: Pendiente → Confirmada → Atendida; Pendiente o Confirmada → Cancelada.
    </p>
}
