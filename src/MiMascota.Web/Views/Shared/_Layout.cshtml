@using Microsoft.Extensions.Options
@using MiMascota.Web.Options
@inject IOptions<ClinicOptions> ClinicOptions
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => controller == name ? "active" : "";
    string? Current(string name) => controller == name ? "page" : null;
    var clinic = ClinicOptions.Value;
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = controller == "Home" && action == "Index";
    // The team section lives on the home page and on "Sobre nosotros".
    var teamHref = isHome || (controller == "Clinic" && action == "About") ? "#equipo" : Url.Action("Index", "Home") + "#equipo";

    // Visitors see the clinic's public pages; staff see the system (Administrador also "Personal").
    var isStaff = User.IsStaff();
    var isAdmin = User.IsAdmin();
    string ActiveAction(string c, string a) => controller == c && action == a ? "active" : "";
    string? CurrentAction(string c, string a) => controller == c && action == a ? "page" : null;
    var displayName = User.FindFirst(StaffClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var initial = displayName.Length > 0 ? char.ToUpper(displayName[0]).ToString() : "?";
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Mi Mascota</title>
    <meta name="theme-color" content="#12CED6" />
    <link rel="icon" href="~/img/paw.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/baloo2-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/montserrat-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isHome ? "is-home" : "is-inner")">
    <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>

    <header class="nav-wrap">
        <nav class="navbar navbar-expand-lg mm-nav" aria-label="Principal">
            <a class="navbar-brand mm-brand" asp-controller="Home" asp-action="Index" aria-label="Mi Mascota, inicio">
                <partial name="_PawIcon" />
                <span>mi mascota</span>
            </a>
            <button class="navbar-toggler mm-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar menú">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (isStaff)
                {
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link @Active("Home")" aria-current="@Current("Home")" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Appointments")" aria-current="@Current("Appointments")" asp-controller="Appointments" asp-action="Index">Citas</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Owners")" aria-current="@Current("Owners")" asp-controller="Owners" asp-action="Index">Dueños</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Pets")" aria-current="@Current("Pets")" asp-controller="Pets" asp-action="Index">Mascotas</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Services")" aria-current="@Current("Services")" asp-controller="Services" asp-action="Index">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link @ActiveAction("Clinic", "Messages")" aria-current="@CurrentAction("Clinic", "Messages")" asp-controller="Clinic" asp-action="Messages">Mensajes @await Component.InvokeAsync("UnreadMessages")</a></li>
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Staff")" aria-current="@Current("Staff")" asp-controller="Staff" asp-action="Index">Personal</a></li>
                        }
                    </ul>
                    <div class="nav-end">
                        <a class="mm-btn mm-btn-primary mm-nav-cta" asp-controller="Appointments" asp-action="Create">+ Nueva cita</a>
                        <div class="dropdown user-menu">
                            <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Mi cuenta: @displayName">
                                <span class="user-initial" aria-hidden="true">@initial</span>
                                <span class="user-text">
                                    <strong>@displayName</strong>
                                    <span>@User.RoleLabel()</span>
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end mm-dropdown">
                                <li class="dropdown-header">@User.Identity?.Name</li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key" aria-hidden="true"></i> Cambiar contraseña</a></li>
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index"><i class="bi bi-people" aria-hidden="true"></i> Personal</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Salir</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link @Active("Home")" aria-current="@Current("Home")" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Services")" aria-current="@Current("Services")" asp-controller="Services" asp-action="Index">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link @ActiveAction("Clinic", "Hours")" aria-current="@CurrentAction("Clinic", "Hours")" asp-controller="Clinic" asp-action="Hours">Horarios</a></li>
                        <li class="nav-item"><a class="nav-link @ActiveAction("Clinic", "Contact")" aria-current="@CurrentAction("Clinic", "Contact")" asp-controller="Clinic" asp-action="Contact">Contacto</a></li>
                    </ul>
                    <a class="mm-btn mm-btn-dark mm-nav-cta" asp-controller="Account" asp-action="Login"><i class="bi bi-person-lock" aria-hidden="true"></i> Entrar <span class="nav-cta-hint">· personal</span></a>
                }
            </div>
        </nav>
    </header>

    <main id="contenido" class="@(isHome ? "" : "mm-container page-main")">
        @if (isHome)
        {
            <div class="mm-container"><partial name="_Alerts" /></div>
        }
        else
        {
            <partial name="_Alerts" />
        }
        @RenderBody()
    </main>

    <footer class="mm-footer">
        <span class="footer-cat" aria-hidden="true"><img src="~/img/mascotas/gato-asomado.webp" alt="" width="794" height="759" loading="lazy" /><img class="kitten-blink" src="~/img/mascotas/gato-parpadeo.webp" alt="" width="794" height="759" loading="lazy" /></span>
        <div class="mm-container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a class="mm-brand mm-brand-light" asp-controller="Home" asp-action="Index">
                        <partial name="_PawIcon" />
                        <span>mi mascota</span>
                    </a>
                    <p class="footer-desc">Clínica veterinaria para perros, gatos, aves, reptiles y pequeños mamíferos.</p>
                    <ul class="footer-contact">
                        <li><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> <a asp-controller="Clinic" asp-action="Directions">Centro, Tantoyuca, Veracruz</a></li>
                        <li><i class="bi bi-clock-fill" aria-hidden="true"></i> <a asp-controller="Clinic" asp-action="Hours">@clinic.OpenDaysLabel() · @clinic.HoursLabel()</a></li>
                        <li><i class="bi bi-whatsapp" aria-hidden="true"></i> <a asp-controller="Clinic" asp-action="Contact" asp-route-motivo="cita">Escríbenos para agendar</a></li>
                    </ul>
                </div>
                <nav class="footer-col" aria-label="Clínica">
                    <h2>Clínica</h2>
                    <a asp-controller="Clinic" asp-action="About">Sobre nosotros</a>
                    <a href="@teamHref">Nuestro equipo</a>
                    <a asp-controller="Clinic" asp-action="Hours">Horarios</a>
                    <a asp-controller="Clinic" asp-action="Directions">Cómo llegar</a>
                </nav>
                <nav class="footer-col" aria-label="Servicios">
                    <h2>Servicios</h2>
                    @await Component.InvokeAsync("FooterServices")
                </nav>
                @if (isStaff)
                {
                    <nav class="footer-col" aria-label="Sistema">
                        <h2>Sistema</h2>
                        <a asp-controller="Appointments" asp-action="Index">Citas</a>
                        <a asp-controller="Appointments" asp-action="Create">Nueva cita</a>
                        <a asp-controller="Owners" asp-action="Index">Dueños</a>
                        <a asp-controller="Pets" asp-action="Index">Mascotas</a>
                    </nav>
                }
                else
                {
                    <nav class="footer-col" aria-label="Citas">
                        <h2>Citas</h2>
                        <a asp-controller="Clinic" asp-action="Contact" asp-route-motivo="cita">Solicita tu cita</a>
                        <a asp-controller="Services" asp-action="Index">Servicios y precios</a>
                        <a asp-controller="Account" asp-action="Login">Acceso del personal</a>
                    </nav>
                }
                <nav class="footer-col" aria-label="Ayuda">
                    <h2>Ayuda</h2>
                    <a asp-controller="Clinic" asp-action="Faq">Preguntas frecuentes</a>
                    <a asp-controller="Clinic" asp-action="Terms">Términos de uso</a>
                    <a asp-controller="Clinic" asp-action="Privacy">Aviso de privacidad</a>
                    <a asp-controller="Clinic" asp-action="Contact">Contacto</a>
                </nav>
            </div>

            <div class="footer-social">
                @* No social accounts yet: the icons stay, but they are not links. *@
                <span class="social-soon" role="img" aria-label="Facebook (próximamente)" title="Próximamente"><i class="bi bi-facebook" aria-hidden="true"></i></span>
                <span class="social-soon" role="img" aria-label="Instagram (próximamente)" title="Próximamente"><i class="bi bi-instagram" aria-hidden="true"></i></span>
                <span class="social-soon" role="img" aria-label="TikTok (próximamente)" title="Próximamente"><i class="bi bi-tiktok" aria-hidden="true"></i></span>
                <a asp-controller="Clinic" asp-action="Contact" aria-label="Escríbenos (Contacto)" title="Escríbenos"><i class="bi bi-whatsapp" aria-hidden="true"></i></a>
            </div>

            <div class="footer-bottom">
                <p class="footer-copy">© 2026 Clínica Veterinaria Mi Mascota. Todos los derechos reservados.</p>
                <p class="footer-note">Sistema de citas desarrollado por Jovany</p>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
