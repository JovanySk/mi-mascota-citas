@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Mi Mascota</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-heart-pulse-fill me-1"></i> Mi Mascota
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Appointments")" asp-controller="Appointments" asp-action="Index">Citas</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Owners")" asp-controller="Owners" asp-action="Index">Dueños</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Pets")" asp-controller="Pets" asp-action="Index">Mascotas</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Services")" asp-controller="Services" asp-action="Index">Servicios</a></li>
                </ul>
                <a class="btn btn-light btn-sm" asp-controller="Appointments" asp-action="Create">
                    <i class="bi bi-calendar-plus"></i> Nueva cita
                </a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container">Clínica Veterinaria Mi Mascota · Sistema de citas</div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
