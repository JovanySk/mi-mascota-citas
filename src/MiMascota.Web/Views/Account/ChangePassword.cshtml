@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}
<header class="page-head page-head-compact">
    <div class="page-head-text">
        <span class="eyebrow">Mi cuenta</span>
        <h1 class="page-title">Cambiar contraseña</h1>
        <p class="page-sub">Al menos 8 caracteres, con letras y números. Al cambiarla se cierran tus otras sesiones abiertas.</p>
    </div>
    <span class="page-giant" aria-hidden="true">llave</span>
    <img class="page-pet page-pet-perico" src="~/img/mascotas/perico.webp" alt="" width="799" height="900" />
</header>

<form asp-action="ChangePassword" method="post" class="mm-card mm-form mm-form-narrow" novalidate>
    <div asp-validation-summary="ModelOnly" class="mm-alert mm-alert-danger"></div>

    <div class="mb-3">
        <label asp-for="CurrentPassword" class="form-label"></label>
        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="new-password-help" />
        <div class="form-text" id="new-password-help">Consejo: una frase corta con un número es fácil de recordar y difícil de adivinar.</div>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg">Guardar contraseña</button>
        <a asp-controller="Home" asp-action="Index" class="mm-btn mm-btn-ghost mm-btn-lg">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
