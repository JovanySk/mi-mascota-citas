@model Pet
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Nueva mascota" : "Editar mascota";
    string[] species = ["Perro", "Gato", "Ave", "Conejo", "Reptil", "Otro"];
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id.ToString())" method="post" class="card card-body" style="max-width: 36rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Species" class="form-label"></label>
            <input asp-for="Species" class="form-control" list="species-list" />
            <datalist id="species-list">
                @foreach (var s in species)
                {
                    <option value="@s"></option>
                }
            </datalist>
            <span asp-validation-for="Species" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Breed" class="form-label"></label>
            <input asp-for="Breed" class="form-control" placeholder="opcional" />
            <span asp-validation-for="Breed" class="text-danger small"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="OwnerId" class="form-label"></label>
        <select asp-for="OwnerId" asp-items='@(ViewData["Owners"] as SelectList)' class="form-select">
            <option value="0">Selecciona un dueño…</option>
        </select>
        <span asp-validation-for="OwnerId" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
