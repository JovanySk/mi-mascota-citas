@model IReadOnlyList<Pet>
@{
    ViewData["Title"] = "Mascotas";
    var ownerName = ViewData["OwnerName"] as string;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Mascotas</h1>
        @if (ownerName is not null)
        {
            <div class="text-muted">De @ownerName · <a asp-action="Index">ver todas</a></div>
        }
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nueva mascota</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No hay mascotas registradas.</div>
}
else
{
    <div class="card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Especie</th>
                    <th>Raza</th>
                    <th>Dueño</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pet in Model)
                {
                    <tr>
                        <td class="fw-semibold">@pet.Name</td>
                        <td>@pet.Species</td>
                        <td>@(pet.Breed ?? "—")</td>
                        <td>@pet.Owner?.Name</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Appointments" asp-action="Create" asp-route-petId="@pet.Id">Agendar cita</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@pet.Id">Editar</a>
                            <form asp-action="Delete" asp-route-id="@pet.Id" method="post" class="d-inline"
                                  data-confirm="¿Eliminar a @pet.Name?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
