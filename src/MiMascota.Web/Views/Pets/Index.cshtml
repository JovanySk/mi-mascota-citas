@model IReadOnlyList<Pet>
@{
    ViewData["Title"] = "Mascotas";
    var ownerName = ViewData["OwnerName"] as string;
}
<header class="page-head">
    <div class="page-head-text">
        <span class="eyebrow">Pacientes</span>
        <h1 class="page-title">Mascotas</h1>
        @if (ownerName is not null)
        {
            <p class="page-sub">De @ownerName · <a asp-action="Index">ver todas</a></p>
        }
        else
        {
            <p class="page-sub">Perros, gatos, aves, tortugas, hurones y más pacientes de la clínica.</p>
        }
        <div class="page-actions">
            <a class="mm-btn mm-btn-primary" asp-action="Create">+ Nueva mascota</a>
        </div>
    </div>
    <span class="page-giant" aria-hidden="true">peludos</span>
    <img class="page-pet page-pet-husky" src="~/img/mascotas/husky.webp" alt="" width="495" height="900" />
</header>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <img src="~/img/mascotas/avatar/conejo.webp" alt="" width="96" height="96" />
        <div>
            <strong>No hay mascotas registradas.</strong>
            <p class="mb-0"><a asp-action="Create">Registra la primera</a>.</p>
        </div>
    </div>
}
else
{
    <ul class="card-grid">
        @foreach (var pet in Model)
        {
            <li class="mm-card pet-card">
                <div class="pet-card-head">
                    <partial name="_PetAvatar" model="pet" />
                    <div>
                        <h2 class="card-name">@pet.Name</h2>
                        <div class="card-meta">@pet.Species · @(pet.Breed ?? "sin raza registrada")</div>
                    </div>
                </div>
                <div class="pet-card-owner"><i class="bi bi-person-heart" aria-hidden="true"></i> @pet.Owner?.Name</div>
                <div class="card-actions">
                    <a class="mm-btn mm-btn-sm mm-btn-primary" asp-controller="Appointments" asp-action="Create" asp-route-petId="@pet.Id">Agendar cita</a>
                    <a class="mm-btn mm-btn-sm mm-btn-ghost" asp-action="Edit" asp-route-id="@pet.Id">Editar</a>
                    <form asp-action="Delete" asp-route-id="@pet.Id" method="post" class="d-inline"
                          data-confirm="¿Eliminar a @pet.Name?">
                        <button type="submit" class="mm-btn mm-btn-sm mm-btn-danger-ghost">Eliminar</button>
                    </form>
                </div>
            </li>
        }
    </ul>
}
