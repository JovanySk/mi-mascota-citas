@model IReadOnlyList<Owner>
@{
    ViewData["Title"] = "Dueños";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Dueños</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> Nuevo dueño</a>
</div>

<form method="get" asp-action="Index" class="mb-3" role="search">
    <div class="input-group" style="max-width: 28rem">
        <input type="search" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Buscar por nombre o teléfono" aria-label="Buscar" />
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No hay dueños registrados.</div>
}
else
{
    <div class="card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Mascotas</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var owner in Model)
                {
                    <tr>
                        <td class="fw-semibold">@owner.Name</td>
                        <td>@owner.Phone</td>
                        <td>@(owner.Email ?? "—")</td>
                        <td>
                            <a asp-controller="Pets" asp-action="Index" asp-route-ownerId="@owner.Id">
                                @(owner.Pets.Count == 0 ? "Sin mascotas" : string.Join(", ", owner.Pets.Select(p => p.Name)))
                            </a>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Pets" asp-action="Create" asp-route-ownerId="@owner.Id">+ Mascota</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@owner.Id">Editar</a>
                            <form asp-action="Delete" asp-route-id="@owner.Id" method="post" class="d-inline"
                                  data-confirm="¿Eliminar a @owner.Name?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
