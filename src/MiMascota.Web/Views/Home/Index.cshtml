@model DashboardViewModel
@inject IClinicHours ClinicHours
@{
    ViewData["Title"] = "Inicio";
    string Capitalize(string text) => text.Length == 0 ? text : char.ToUpper(text[0]) + text[1..];

    var todayLabel = Capitalize(Model.Today.ToString("dddd d 'de' MMMM"));
    var pendingToday = Model.CountFor(AppointmentStatus.Pending);
    var quick = Model.QuickService;
    var quickDayLabel = Model.QuickDate == Model.Today.AddDays(1)
        ? "mañana"
        : Model.QuickDate.ToString("dddd d 'de' MMMM");
    ViewData["ReturnUrl"] = "/#agenda"; // state-change buttons come back to this section
    ViewData["Compact"] = true;

    // Visitors never get owners' names or appointment data: they see the public version of each block.
    var staff = Model.IsStaff;
    var speciesCount = SpeciesCatalog.Options.Count(o => o.Value != SpeciesCatalog.Other);

    (string Image, string Label, string Alt)[] family =
    [
        ("husky", "Perros", "Cachorro husky"),
        ("frenchie-cono", "En recuperación", "Bulldog francés con collar isabelino"),
        ("cuyo", "Cuyos", "Cuyo"),
        ("hamster", "Hámsters", "Hámster con estetoscopio"),
        ("conejo", "Conejos", "Conejo belier"),
        ("salchicha-enfermera", "Enfermería", "Perro salchicha con uniforme de enfermería")
    ];
}

@* ───────── Hero ───────── *@
<section class="hero" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <span class="giant hero-giant" aria-hidden="true">mascota</span>
    <img class="bone bone-1" src="~/img/mascotas/hueso.webp" alt="" width="800" height="550" />
    <img class="bone bone-2" src="~/img/mascotas/hueso.webp" alt="" width="800" height="550" />

    <div class="hero-puppy" aria-hidden="true">
        <div class="puppy-frames">
            <img class="pf pf-up" src="~/img/mascotas/perro-pata.webp" alt="" width="475" height="900" fetchpriority="high" />
            <img class="pf pf-mid" src="~/img/mascotas/perro-pata-media.webp" alt="" width="475" height="900" />
            <img class="pf pf-down" src="~/img/mascotas/perro-pata-abajo.webp" alt="" width="475" height="900" />
        </div>
    </div>

    <div class="mm-container hero-inner">
        <div class="hero-copy">
            <div class="hero-title-wrap">
                <div class="hero-kitten" aria-hidden="true">
                    <div class="kitten-frames">
                        <img src="~/img/mascotas/gato-asomado.webp" alt="" width="794" height="759" />
                        <img class="kitten-blink" src="~/img/mascotas/gato-parpadeo.webp" alt="" width="794" height="759" />
                    </div>
                </div>
                <h1 id="hero-title" class="hero-title">
                    <span class="text-turquoise">Pequeños cuidados,</span>
                    <span>grandes resultados</span>
                </h1>
            </div>
            <p class="hero-sub">Agenda la consulta de tu mejor amigo en segundos: solo te mostramos horarios libres, sin empalmes.</p>
            <div class="hero-ctas">
                <a class="mm-cta" href="@BookingLinks.For(Url, User)">
                    <span class="mm-cta-text"><strong>Agenda una cita</strong><span>en segundos</span></span>
                    <i class="bi bi-whatsapp" aria-hidden="true"></i>
                </a>
                <a class="mm-cta-outline" asp-controller="Services" asp-action="Index">Ver servicios <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
        </div>
    </div>

    <ul class="hero-cards" aria-label="Resumen de la clínica">
        @if (staff)
        {
            <li class="info-card">
                <span class="info-num" data-count="@Model.TodayAppointments.Count">@Model.TodayAppointments.Count</span>
                <span class="info-label">@(Model.TodayAppointments.Count == 1 ? "cita hoy" : "citas hoy")</span>
                <span class="info-sub">@pendingToday por confirmar</span>
            </li>
        }
        else
        {
            <li class="info-card">
                <span class="info-num" data-count="@speciesCount">@speciesCount</span>
                <span class="info-label">especies atendidas</span>
                <span class="info-sub">perros, gatos y exóticos</span>
            </li>
        }
        <li class="info-card">
            <span class="info-num">@Model.HoursLabel</span>
            <span class="info-label">@Model.OpenDaysLabel</span>
            <span class="info-sub">cada @Model.SlotMinutes min</span>
        </li>
        <li class="info-card">
            <span class="info-num" data-count="0">0</span>
            <span class="info-label">empalmes</span>
            <span class="info-sub">@(staff ? "el sistema los bloquea" : "tu hora es solo tuya")</span>
        </li>
    </ul>
</section>

@* ───────── Atendemos a toda la familia ───────── *@
<section class="family" id="familia" aria-labelledby="family-title">
    <div class="mm-container">
        <h2 id="family-title" class="section-title">Atendemos a<br /><span class="text-turquoise">toda la familia</span></h2>
        <p class="section-sub">Perros de todas las razas, gatos, cuyos, hámsters y conejos.<br class="d-none d-md-inline" /> Cada especie con su servicio y su propia duración de cita.</p>
    </div>
    <div class="family-stage" data-reveal>
        <span class="giant family-giant" aria-hidden="true">todos</span>
        <div class="family-floor" aria-hidden="true"></div>
        <ul class="mm-container family-row">
            @for (var i = 0; i < family.Length; i++)
            {
                var pet = family[i];
                <li class="family-pet family-pet-@pet.Image" style="--i:@i">
                    <img src="~/img/mascotas/@(pet.Image).webp" alt="@pet.Alt" loading="lazy" />
                    <span class="chip-white">@pet.Label</span>
                </li>
            }
        </ul>
    </div>
</section>

@* ───────── Nuestro equipo ───────── *@
<partial name="_Team" />

@* ───────── Agenda de hoy (the real system panel, staff only) ───────── *@
@if (staff)
{
<section class="agenda" id="agenda" aria-labelledby="agenda-title">
    <div class="mm-container">
        <div class="agenda-grid">
            <div class="agenda-main">
                <div class="agenda-head">
                    <h2 id="agenda-title" class="section-title mb-0">Agenda de hoy</h2>
                    <span class="date-chip">@todayLabel</span>
                </div>

                <div class="filter-chips" role="group" aria-label="Filtrar por estado" data-filter-group>
                    <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">Todas · @Model.TodayAppointments.Count</button>
                    @foreach (var status in Enum.GetValues<AppointmentStatus>())
                    {
                        var label = status switch
                        {
                            AppointmentStatus.Pending => "Pendientes",
                            AppointmentStatus.Confirmed => "Confirmadas",
                            AppointmentStatus.Attended => "Atendidas",
                            _ => "Canceladas"
                        };
                        <button type="button" class="filter-chip" data-filter="@status" aria-pressed="false">@label · @Model.CountFor(status)</button>
                    }
                </div>

                @if (Model.TodayAppointments.Count == 0)
                {
                    <div class="empty-state">
                        <img src="~/img/mascotas/avatar/hamster.webp" alt="" width="96" height="96" />
                        <div>
                            <strong>No hay citas para hoy.</strong>
                            <p class="mb-0">Agenda la primera desde <a asp-controller="Appointments" asp-action="Create">Nueva cita</a>.</p>
                        </div>
                    </div>
                }
                else
                {
                    <ul class="appt-list" data-filter-list>
                        @foreach (var a in Model.TodayAppointments)
                        {
                            <li data-status="@a.Status">
                                <partial name="_AppointmentRow" model="a" />
                            </li>
                        }
                    </ul>
                    <p class="filter-empty" hidden>No hay citas con ese estado hoy.</p>
                }

                <a class="link-arrow" asp-controller="Appointments" asp-action="Index" asp-route-date="@Model.Today.ToString("yyyy-MM-dd")">Ver y administrar todas las citas de hoy <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>

            <aside class="agenda-side" aria-labelledby="quick-title">
                <img class="quick-hamster" src="~/img/mascotas/hamster.webp" alt="" width="519" height="726" loading="lazy" />
                <div class="quick-card">
                    <h2 id="quick-title" class="quick-title">Nueva cita rápida</h2>
                    @if (quick is null)
                    {
                        <p class="quick-sub">Registra primero un servicio para poder agendar.</p>
                        <a class="mm-btn mm-btn-dark w-100" asp-controller="Services" asp-action="Create">Crear servicio</a>
                    }
                    else
                    {
                        <p class="quick-sub">@quick.Name · @quick.DurationMinutes min · @quickDayLabel</p>
                        @* Filled by wwwroot/js/home.js with GET /Appointments/Availability (AJAX). *@
                        <div class="quick-slots" id="quick-slots"
                             data-availability-url="@Url.Action("Availability", "Appointments")"
                             data-create-url="@Url.Action("Create", "Appointments")"
                             data-service-id="@quick.Id"
                             data-date="@Model.QuickDate.ToString("yyyy-MM-dd")"
                             data-open="@Model.OpeningTime.ToString("HH:mm")"
                             data-close="@Model.ClosingTime.ToString("HH:mm")"
                             data-step="@Model.SlotMinutes"
                             data-duration="@quick.DurationMinutes"
                             aria-live="polite">
                            <span class="quick-loading">Cargando horarios…</span>
                        </div>
                        <p class="quick-note">Horarios tachados = ocupados. Se cargan sin recargar la página.</p>
                        <a class="mm-btn mm-btn-dark w-100" id="quick-book"
                           asp-controller="Appointments" asp-action="Create"
                           asp-route-serviceId="@quick.Id" asp-route-date="@Model.QuickDate.ToString("yyyy-MM-dd")">Elegir horario</a>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>
}
else
{
    var week = ClinicHours.Week();
    <section class="agenda agenda-public" id="agendar" aria-labelledby="book-title">
        <div class="mm-container">
            <div class="agenda-grid">
                <div class="agenda-main">
                    <div class="agenda-head">
                        <h2 id="book-title" class="section-title mb-0">¿Quieres agendar?</h2>
                        <partial name="_OpenBadge" model="ClinicHours.GetStatus()" />
                    </div>
                    <p class="section-sub">Escríbenos el nombre de tu mascota, el servicio que necesita y el día que te acomoda. Te respondemos con un horario libre para que llegues y te atendamos a tiempo.</p>
                    <ol class="book-steps">
                        <li>
                            <span class="book-step-num" aria-hidden="true">1</span>
                            <div><strong>Escríbenos</strong><span>Desde Contacto, con tu teléfono o correo.</span></div>
                        </li>
                        <li>
                            <span class="book-step-num" aria-hidden="true">2</span>
                            <div><strong>Te confirmamos</strong><span>Un horario libre, sin empalmes con otras citas.</span></div>
                        </li>
                        <li>
                            <span class="book-step-num" aria-hidden="true">3</span>
                            <div><strong>Llegas a tu cita</strong><span>Con la cartilla de vacunas si la tienes.</span></div>
                        </li>
                    </ol>
                    <div class="hero-ctas book-ctas">
                        <a class="mm-btn mm-btn-primary mm-btn-lg" asp-controller="Clinic" asp-action="Contact" asp-route-motivo="cita">Solicita tu cita <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        <a class="mm-btn mm-btn-ghost mm-btn-lg" asp-controller="Services" asp-action="Index">Servicios y precios</a>
                    </div>
                </div>

                <aside class="agenda-side" aria-labelledby="hours-title">
                    <img class="quick-hamster" src="~/img/mascotas/hamster.webp" alt="" width="519" height="726" loading="lazy" />
                    <div class="quick-card">
                        <h2 id="hours-title" class="quick-title">Horarios</h2>
                        <p class="quick-sub">@Model.OpenDaysLabel · @Model.HoursLabel · citas cada @Model.SlotMinutes min</p>
                        <ul class="mini-week">
                            @foreach (var day in week)
                            {
                                <li class="@(day.IsToday ? "is-today" : null) @(day.IsClosed ? "is-closed" : null)">
                                    <span>@day.Name</span>
                                    <span>@(day.IsClosed ? "Cerrado" : $"{day.Opening:H:mm} – {day.Closing:H:mm}")</span>
                                </li>
                            }
                        </ul>
                        <a class="mm-btn mm-btn-dark w-100" asp-controller="Clinic" asp-action="Hours">Ver horarios y cómo llegar</a>
                    </div>
                </aside>
            </div>
        </div>
    </section>
}

@* ───────── Bath banner ───────── *@
<section class="bath" aria-labelledby="bath-title">
    <div class="bath-giant" aria-hidden="true">
        <span class="giant">baño</span>
        <span class="giant">baño</span>
        <span class="giant">baño</span>
    </div>
    <img class="bath-pets" src="~/img/mascotas/pacientes.webp" alt="Perro y gato envueltos en una toalla después del baño" width="1021" height="776" loading="lazy" />
    <img class="bone bone-3" src="~/img/mascotas/hueso.webp" alt="" width="800" height="550" loading="lazy" />
    <div class="mm-container bath-inner">
        <p class="bath-hello">¡Hola, humano!</p>
        <h2 id="bath-title" class="bath-title">Es hora de un<br /><span class="text-turquoise">baño</span></h2>
        @if (Model.BathService is { } bath)
        {
            <p class="bath-text">@bath.Name desde @bath.Price.ToString("C0") · @bath.DurationMinutes minutos.</p>
            <a class="mm-btn mm-btn-primary mm-btn-lg" href="@BookingLinks.For(Url, User, bath.Id, bath.Name)">Reservar baño <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        }
        else
        {
            <p class="bath-text">Pronto agregaremos baño y estética al catálogo de servicios.</p>
            <a class="mm-btn mm-btn-primary mm-btn-lg" asp-controller="Services" asp-action="Index">Ver servicios <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
